# OmniPost environment — copy to .env and fill in. Never commit .env.
# The Go backend reads OMNIPOST_SMTP_* on startup/install and configures the
# default Hostinger SMTP preset automatically. Unset = use DB / Settings UI.

# --- E-mail channel (Hostinger preset) ---
OMNIPOST_SMTP_HOST=smtp.hostinger.com
OMNIPOST_SMTP_PORT=465
OMNIPOST_SMTP_USERNAME=contact@appzenowebservices.com
OMNIPOST_SMTP_PASSWORD=changeme
OMNIPOST_SMTP_AUTH=login
OMNIPOST_SMTP_TLS=TLS
OMNIPOST_SMTP_NAME=email-omnipost
OMNIPOST_FROM_EMAIL=OmniPost <contact@appzenowebservices.com>

# --- Web-push channel (Firebase Cloud Messaging) ---
# 1) Firebase Console → your project → Cloud Messaging → Web Push certificates
#    → Generate key pair → FIREBASE_VAPID_KEY (public).
# 2) Firebase Console → Project settings → Service accounts → Generate new
#    private key → paste the whole JSON on ONE line → FIREBASE_SERVICE_ACCOUNT_KEY (secret).
# The JS client, /firebase-messaging-sw.js, and the Go sender all read these
# server-side values, so a project mismatch is impossible by construction.
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional: derived from the service-account JSON when empty.
FIREBASE_PROJECT_ID=
# Public web-app keys (Project settings → General → Your apps → Web app).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=

# --- App / DB (docker-compose) ---
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
LISTMONK_app__address=0.0.0.0:9000
