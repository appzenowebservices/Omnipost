# Patra environment — copy to .env and fill in. Never commit .env.
# The Go backend reads PATRA_SMTP_* on startup/install and configures the
# default Hostinger SMTP preset automatically. Unset = use DB / Settings UI.

# --- E-mail channel (Hostinger preset) ---
PATRA_SMTP_HOST=smtp.hostinger.com
PATRA_SMTP_PORT=465
PATRA_SMTP_USERNAME=contact@appzenowebservices.com
PATRA_SMTP_PASSWORD=changeme
PATRA_SMTP_AUTH=login
PATRA_SMTP_TLS=TLS
PATRA_SMTP_NAME=email-patra
PATRA_FROM_EMAIL=Patra <contact@appzenowebservices.com>

# --- Web-push channel (Firebase Cloud Messaging) ---
# Project: service-hub (service-hub-df5e3). The web-app values and the VAPID
# key are public by design (they ship to the browser); only the service
# account key is a secret.
# 1) FIREBASE_VAPID_KEY: Firebase Console → service-hub-df5e3 → Cloud Messaging
#    → Web Push certificates. Reuse the same key pair already used by the
#    service-hub app (its NEXT_PUBLIC_FIREBASE_VAPID_KEY value).
# 2) FIREBASE_SERVICE_ACCOUNT_KEY (secret): Console → Project settings →
#    Service accounts → Generate new private key → paste the JSON on ONE line.
# The JS client, /firebase-messaging-sw.js, and the Go FCM sender all read
# these server-side values, so a project mismatch is impossible by construction.
FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=

# --- Database (managed Postgres, eg: Supabase) ---
# Paste ONE full URL. Preferred: the Supavisor SESSION pooler (IPv4-safe,
# keeps prepared statements working):
# postgresql://postgres.<ref>:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (Dashboard → Project Settings → Database → Connection string → pooler + Session mode.)
# Direct (db.<ref>.supabase.co:5432) works only from hosts with IPv6.
# Never use the :6543 transaction pooler — it breaks prepared statements
# ("prepared statement does not exist").
PATRA_DATABASE_URL=
# Fallback split fields (only used when PATRA_DATABASE_URL is empty).
#PATRA_db__host=db.xxx.supabase.co
#PATRA_db__port=5432
#PATRA_db__user=postgres
#PATRA_db__password=
#PATRA_db__database=postgres
#PATRA_db__ssl_mode=require

# --- App (docker-compose) ---
# Environment-configured Super Admin: signs in at /admin/login without a row
# in the users table (which stays reserved for tenant users). Leave empty to
# disable, or set both to enable. Fallbacks: LISTMONK_ADMIN_USER/PASSWORD.
PATRA_ADMIN_USER=
PATRA_ADMIN_PASSWORD=
PATRA_app__address=0.0.0.0:9000
# Public base URL for subscription pages, archive links and opt-in e-mails.
# Must be the production URL (the DB default is http://localhost:9000).
PATRA_app__root_url=https://omnipost.appzenowebservices.com
