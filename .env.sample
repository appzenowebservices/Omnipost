# OmniPost environment — copy to .env and fill in. Never commit .env.
# The Go backend reads OMNIPOST_SMTP_* on startup/install and configures the
# default Hostinger SMTP preset automatically. Unset = use DB / Settings UI.

# --- E-mail channel (Hostinger preset) ---
OMNIPOST_SMTP_HOST=smtp.hostinger.com
OMNIPOST_SMTP_PORT=465
OMNIPOST_SMTP_USERNAME=contact@appzenowebservices.com
OMNIPOST_SMTP_PASSWORD=changeme
OMNIPOST_SMTP_AUTH=login
OMNIPOST_SMTP_TLS=TLS
OMNIPOST_SMTP_NAME=email-omnipost
OMNIPOST_FROM_EMAIL=OmniPost <contact@appzenowebservices.com>

# --- App / DB (docker-compose) ---
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
LISTMONK_app__address=0.0.0.0:9000
