# A simpler version of the service template with wider compatibility for older OS's

[Unit]
Description=Patra email service
ConditionPathExists=/etc/patra/config.toml
Wants=network.target
# The PostgreSQL database may not be on the same host but if it
# is patra should wait for it to start up.
After=postgresql.service

[Service]
Type=simple
PermissionsStartOnly=true
WorkingDirectory=/usr/bin
ExecStartPre=/usr/bin/mkdir -p "/etc/patra/uploads"
ExecStartPre=/usr/bin/patra --config /etc/patra/config.toml --upgrade --yes
ExecStart=/usr/bin/patra --config /etc/patra/config.toml
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# To enable a static dir, add the following 
# --static-dir /etc/patra/static
# to the end of the ExecStart line above after creating the dir and fetching the files with:
# mkdir -p /etc/patra/static ; wget -O - https://github.com/appzenowebservices/Omnipost/archive/master.tar.gz | tar xz -C /etc/patra/static --strip=2 "Omnipost-master/static"

# To enable a log file that persists after restarts, replace the ExecStart= line with:
# ExecStart=/bin/bash -ce "exec /usr/bin/patra --config /etc/patra/config.toml --static-dir /etc/patra/static >>/etc/patra/patra.log 2>&1"

# Set user to run patra service as (instead of root).
# Can use "DynamicUser=" instead, if your systemd version is >= 232.
# https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#DynamicUser=
#User=
#StateDirectory=/etc/patra
#Environment=HOME=/usr/bin

# Use systemd’s ability to disable security-sensitive features
# that patra does not explicitly need.
# NoNewPrivileges should be enabled by DynamicUser=yes but systemd-analyze
# still recommended to explicitly enable it.
NoNewPrivileges=True
# patra doesn’t need any capabilities as defined by the linux kernel
# see: https://man7.org/linux/man-pages/man7/capabilities.7.html
CapabilityBoundingSet=
# patra only executes native code with no need for any other ABIs.
SystemCallArchitectures=native

# Make /home/, /root/, and /run/user/ inaccessible.
# ProtectSystem=strict and ProtectHome=read-only are implied by DynamicUser=True
# If you set ExecStartPre=/usr/bin/mkdir -p "patra/uploads" to a directory in /home/ or /root/ it will cause uploads to fail 
# See https://github.com/appzenowebservices/Omnipost/issues/843#issuecomment-1836023524
ProtectHome=True

# Make sure files created by patra are only readable by itself and
# others in the patra system group.
UMask=0027
# patra only needs to support the IPv4 and IPv6 address families.
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
